        "thick"                  support.function.tikz entity.name.function.tikz
        "]"                      punctuation.section.options.end.tikz
        "("                      punctuation.section.coordinate.begin.tikz
        "0"                      constant.numeric.tikz
        ","                      punctuation.separator.tikz
        "0"                      constant.numeric.tikz
        ")"                      punctuation.section.coordinate.end.tikz
        "--"                     keyword.operator.path.tikz
        "("                      punctuation.section.coordinate.begin.tikz
        "1"                      constant.numeric.tikz
        ","                      punctuation.separator.tikz
