#!/bin/sh
# Run every check in the repo.
#
# The grammar tests need VS Code itself, since they run its own TextMate engine: tools/tm
# finds an installation, or $VSCODE names one. Everything else runs under any node, and
# with none installed, under the one inside VS Code.
set -e

cd "$(dirname "$0")/.."

if command -v node >/dev/null 2>&1; then
  RUN() { node "$@"; }
else
  RUN() { ./tools/tm "$@"; }
fi

python3 tools/check
RUN tools/test-symbols.js
RUN tools/test-extension.js
./tools/tm tools/test-grammar.mjs
python3 tools/test-tools
