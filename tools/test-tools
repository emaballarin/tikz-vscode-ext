            product = {"nameShort": name_short, "darwinExecutable": darwin_executable}
            (bundle / "Contents" / "Resources" / "app" / "product.json").write_text(json.dumps(product, indent=2))
            executable = bundle / "Contents" / "MacOS" / name_short
