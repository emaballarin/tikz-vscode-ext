#!/usr/bin/env python3
"""Check that the scripts under tools/ still run, without disturbing the tree.

They are normally exercised only by a human running them, so a moved field or a shell
quoting slip breaks them silently until the day one is needed -- which is how
tools/package spent its life unable to run on Linux.

Nothing may modify the working tree; the last test hashes it before and after. So
`package` runs against a copy, and `check` is run against deliberately broken copies as
well as a good one: a verifier that cannot fail is worth nothing, and its verdict is what
a release gets gated on.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ElementTree
import zipfile
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parent.parent
SKIPPED = {".git", "node_modules", ".vscode-test", "__pycache__"}
IGNORED = shutil.ignore_patterns("node_modules", ".vscode-test", "__pycache__", "*.vsix", ".DS_Store")

failures = []
run = 0


def test(name):
    """Decorator: run the body, collect the failure rather than stopping at the first."""

    def wrap(body):
        global run
        run += 1
        try:
            body()
        except Exception as error:  # noqa: BLE001 - a failed check is a report, not a crash
            failures.append(f"{name}\n  {type(error).__name__}: {error}")

    return wrap


def digest(root):
    """A hash of every file under `root`, path and content alike."""
    total = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file()):
        relative = path.relative_to(root)
        if relative.parts and relative.parts[0] in SKIPPED:
            continue
        if path.suffix == ".vsix":
            continue
        total.update(str(relative).encode("utf-8"))
        total.update(path.read_bytes())
    return total.hexdigest()


def copy_tree(destination, git=True):
    """The repository, minus what packaging and testing leave lying around. The history
    comes along by default, since tools/package reads it to pin the README's images."""
    ignore = IGNORED if git else shutil.ignore_patterns(".git", *SKIPPED, "*.vsix", ".DS_Store")
    shutil.copytree(ROOT, destination, ignore=ignore, symlinks=True)
    return destination


def run_script(script, cwd, *args):
    return subprocess.run(
        [str(script), *args], cwd=str(cwd), capture_output=True, text=True, timeout=300, check=False
    )


def node(*args):
    """Run a script under node, or under VS Code's own when none is installed."""
    runner = [shutil.which("node")] if shutil.which("node") else [str(ROOT / "tools" / "tm")]
    return subprocess.run([*runner, *args], cwd=str(ROOT), capture_output=True, text=True, timeout=120, check=False)


def plain(text):
    """Output without its colour codes."""
    return re.sub(r"\x1b\[[0-9;]*m", "", text)


def run_example(project, figure, *, latexmk="exit 0", texinputs=None):
    """Run examples/fig.sh from `project` on `figure`, with a stub latexmk that records the
    TEXINPUTS it was given. Returns that, the generated build/fig.tex and the status line."""
    shutil.copy(ROOT / "examples" / "fig.sh", project / "fig.sh")
    stub = project.parent / "bin"
    stub.mkdir(exist_ok=True)
    (stub / "latexmk").write_text(f'#!/bin/sh\necho "$TEXINPUTS" > "{project.parent}/texinputs"\n{latexmk}\n')
    (stub / "latexmk").chmod(0o755)
    env = {**os.environ, "PATH": f"{stub}{os.pathsep}{os.environ['PATH']}"}
    env.pop("TEXINPUTS", None)
    if texinputs is not None:
        env["TEXINPUTS"] = texinputs
    result = subprocess.run(
        [str(project / "fig.sh"), str(figure)], cwd=str(project), env=env, capture_output=True, text=True, check=False
    )
    assert result.returncode == 0, f"exit {result.returncode}: {result.stderr.strip()}"
    return (
        (project.parent / "texinputs").read_text().strip(),
        (project / "build" / "fig.tex").read_text(),
        (project / "build" / ".build-status").read_text().strip(),
    )


def edit_json(path, mutate):
    data = json.loads(path.read_text(encoding="utf-8"))
    mutate(data)
    path.write_text(json.dumps(data, indent=4, ensure_ascii=False) + "\n", encoding="utf-8")


def package(tree):
    """Run tools/package in `tree` and return the vsix it announced."""
    result = run_script(tree / "tools" / "package", tree)
    assert result.returncode == 0, f"exit {result.returncode}: {result.stderr.strip()}"
    vsix = Path(result.stdout.strip().splitlines()[-1])
    assert vsix.is_file(), f"{vsix} was announced but not written"
    return vsix, result


NAMESPACE = {"v": "http://schemas.microsoft.com/developer/vsx-schema/2011"}

BEFORE = digest(ROOT)
# A vsix the person running this built themselves is theirs; it must still be there, and
# still be the same file, so a test that packaged in place cannot hide behind it.
def vsix_files():
    return {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in ROOT.glob("*.vsix")}


VSIX_BEFORE = vsix_files()


@test("every script under tools/ is executable and has a shebang")
def _():
    for script in sorted(ROOT.glob("tools/*")):
        if script.suffix in (".js", ".mjs") or not script.is_file():
            continue
        assert script.stat().st_mode & 0o111, f"{script.name} is not executable"
        first = script.read_bytes().split(b"\n", 1)[0]
        assert first.startswith(b"#!"), f"{script.name} has no shebang"


@test("tools/check passes on the tree as it stands")
def _():
    with tempfile.TemporaryDirectory() as tmp:
        good = copy_tree(Path(tmp) / "good", git=False)
        result = run_script(good / "tools" / "check", good)
        assert result.returncode == 0, f"exit {result.returncode}: {result.stderr.strip()}"
        assert "ok:" in result.stdout, result.stdout


@test("tools/check fails on trees it is supposed to reject")
def _():
    # Each corruption targets a different check, so a single one going vacuous is caught.
    def broken(mutate, expected):
        with tempfile.TemporaryDirectory() as tmp:
            tree = copy_tree(Path(tmp) / "broken", git=False)
            mutate(tree)
            result = run_script(tree / "tools" / "check", tree)
            assert result.returncode != 0, f"accepted a tree it should reject ({expected})"
            assert expected in result.stderr, f"expected {expected!r}, got: {result.stderr.strip()}"

    def drop_grammar(tree):
        (tree / "syntaxes" / "tikz-toplevel.tmLanguage.json").unlink()

    def break_include(tree):
        path = tree / "syntaxes" / "tikz-injection.tmLanguage.json"
        path.write_text(path.read_text(encoding="utf-8").replace('"#dimension"', '"#dimensions"', 1))

    def misstate_default(tree):
        path = tree / "README.md"
        path.write_text(path.read_text(encoding="utf-8").replace("`./fig.sh`", "`./figure.sh`", 1))

    def orphan_command(tree):
        edit_json(
            tree / "package.json",
            lambda m: m["contributes"]["commands"].append({"command": "tikz.ghost", "title": "TikZ: Ghost"}),
        )

    def unread_setting(tree):
        edit_json(
            tree / "package.json",
            lambda m: m["contributes"]["configuration"]["properties"].update(
                {"tikz.ghost": {"type": "string", "default": "", "description": "Nothing reads this."}}
            ),
        )

    def drop_icon(tree):
        (tree / "images" / "icon.png").unlink()

    def rainbow_tikz(tree):
        path = tree / "settings-snippet.jsonc"
        path.write_text(path.read_text(encoding="utf-8").replace('"[tikz]"', '"[tikz-unrelated]"', 1))

    def drop_activation(tree):
        edit_json(tree / "package.json", lambda m: m["activationEvents"].remove("onLanguage:tikz"))

    def mistype_token(tree):
        edit_json(tree / "package.json", lambda m: m["contributes"]["semanticTokenTypes"][0].update(id="tikzMacros"))

    broken(drop_grammar, "grammar ./syntaxes/tikz-toplevel.tmLanguage.json is missing")
    broken(break_include, "includes #dimensions, which its repository lacks")
    broken(misstate_default, "README gives tikz.figureScript the default ./figure.sh")
    broken(orphan_command, "command tikz.ghost is declared but never registered")
    broken(unread_setting, "setting tikz.ghost is declared but nothing reads it")
    broken(drop_icon, "is missing")
    broken(rainbow_tikz, "leaves bracket pair colours on for [tikz]")
    broken(drop_activation, "no onLanguage:tikz activation event")
    broken(mistype_token, "semantic token types")


@test("tools/check reads JSONC whose strings end in an escaped backslash")
def _():
    loader = SourceFileLoader("check", str(ROOT / "tools" / "check"))
    module = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    text = '{\n  // a comment\n  "path": "C:\\\\", /* and another */ "next": "a // b",\n}'
    assert json.loads(module.strip_jsonc(text)) == {"path": "C:\\", "next": "a // b"}


@test("tools/package builds an installable vsix from a copy of the tree")
def _():
    if shutil.which("zip") is None:
        raise AssertionError("no zip on this machine, so tools/package cannot run here")
    manifest = json.loads((ROOT / "package.json").read_text(encoding="utf-8"))
    with tempfile.TemporaryDirectory() as tmp:
        tree = copy_tree(Path(tmp) / "tree")
        vsix, _ = package(tree)
        with zipfile.ZipFile(vsix) as archive:
            members = set(archive.namelist())
            for required in (
                "extension.vsixmanifest",
                "[Content_Types].xml",
                "extension/package.json",
                "extension/README.md",
                "extension/LICENSE",
                "extension/src/extension.js",
                "extension/syntaxes/tikz-injection.tmLanguage.json",
                "extension/examples/fig.sh",
                "extension/images/icon.png",
            ):
                assert required in members, f"{required} is missing from the vsix"
            assert not any(name.startswith("extension/.git/") for name in members), ".git shipped"
            # The root of a vsix is the two metadata files and the extension; anything else
            # there is staging left behind.
            root = {name for name in members if not name.startswith("extension/")}
            assert root == {"extension.vsixmanifest", "[Content_Types].xml"}, f"stray files at the root: {root}"
            document = ElementTree.fromstring(archive.read("extension.vsixmanifest"))
            readme = archive.read("extension/README.md").decode("utf-8")

        identity = document.find(".//v:Identity", NAMESPACE)
        assert identity.get("Id") == manifest["name"], identity.get("Id")
        assert identity.get("Version") == manifest["version"], identity.get("Version")
        assert identity.get("Publisher") == manifest["publisher"], identity.get("Publisher")
        assert document.find(".//v:DisplayName", NAMESPACE).text == manifest["displayName"]

        # The extension page draws only http(s) images, so the packaged README must point at
        # GitHub, pinned to a commit, wherever the checked-in one points at the file.
        assert "](images/" not in readme, "the packaged README still points at images/ relatively"
        if "raw.githubusercontent.com/" not in readme:
            raise AssertionError("the packaged README lost its image instead of pinning it")


@test("tools/package leaves out what .gitignore leaves out, and the VS Code CI downloads")
def _():
    with tempfile.TemporaryDirectory() as tmp:
        tree = copy_tree(Path(tmp) / "tree")
        for junk in ("node_modules/x/index.js", ".DS_Store", "src/.DS_Store", ".vscode-test/stable/code"):
            (tree / junk).parent.mkdir(parents=True, exist_ok=True)
            (tree / junk).write_text("junk")
        vsix, _ = package(tree)
        with zipfile.ZipFile(vsix) as archive:
            shipped = [n for n in archive.namelist() if any(j in n for j in ("node_modules", ".DS_Store", ".vscode-test"))]
        assert not shipped, f"shipped {shipped}"


@test("tools/package ships what git would commit, so a self-ignoring cache stays out")
def _():
    # Tools that drop a cache in the tree often ignore it from inside -- ruff writes a
    # .gitignore of "*" into .ruff_cache -- so git never shows it, and a tar of the tree
    # shipped it all the same. A file deleted from the tree but still tracked must not
    # trip the packaging either.
    with tempfile.TemporaryDirectory() as tmp:
        tree = copy_tree(Path(tmp) / "tree")
        cache = tree / ".ruff_cache"
        (cache / "0.9").mkdir(parents=True)
        (cache / ".gitignore").write_text("*\n")
        (cache / "0.9" / "entry").write_text("junk")
        (tree / "src" / "stale.vsix").write_text("junk")
        (tree / "docs" / "authoring.md").unlink()
        vsix, _ = package(tree)
        with zipfile.ZipFile(vsix) as archive:
            names = archive.namelist()
        assert not any(".ruff_cache" in n or n.endswith(".vsix") for n in names), [n for n in names if "ruff" in n]
        assert "extension/docs/authoring.md" not in names, "a deleted file was shipped"
        assert "extension/docs/highlighting.md" in names


@test("tools/package fails rather than ship a tree it could not read whole")
def _():
    # The staging copy was a pipeline, and under sh -e only its last stage counts: a tar that
    # failed on one file still let the extracting tar succeed, and the vsix went out short.
    if os.geteuid() == 0:
        print("skip: running as root, which reads an unreadable file anyway", file=sys.stderr)
        return
    # A tracked file, a tracked folder, and a folder git does not track yet, which git skips
    # with no more than a warning -- and a tracked folder that can be listed but not entered,
    # of which git says nothing, so that only packaging's own check stands in the way.
    for locked, locked_mode, mode in (
        ("docs/authoring.md", 0, 0o644),
        ("docs", 0, 0o755),
        ("drafts", 0, 0o755),
        ("docs", 0o644, 0o755),
    ):
        with tempfile.TemporaryDirectory() as tmp:
            tree = copy_tree(Path(tmp) / "tree")
            (tree / "drafts").mkdir()
            (tree / "drafts" / "figure.tex").write_text("\\draw (0,0);\n")
            (tree / locked).chmod(locked_mode)
            try:
                result = run_script(tree / "tools" / "package", tree)
            finally:
                (tree / locked).chmod(mode)
            assert result.returncode != 0, f"packaged a tree with {locked} unreadable"
            assert not list(tree.glob("*.vsix")), f"wrote a vsix anyway, with {locked} unreadable"
            assert locked in result.stderr, f"did not name {locked}: {result.stderr}"


