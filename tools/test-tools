@test("tools/package decodes the manifest as JSON and writes it as XML")
def _():
    # A sed capture copies `\\` where package.json means one backslash, and an `&` or a `<`
    # copied raw makes the vsixmanifest ill-formed, which the installer rejects silently.
    awkward = "Draw <figures> & \\paths \"quoted\""
    with tempfile.TemporaryDirectory() as tmp:
        tree = copy_tree(Path(tmp) / "tree")
        edit_json(tree / "package.json", lambda m: m.update(description=awkward, displayName="TikZ & co"))
        vsix, _ = package(tree)
        with zipfile.ZipFile(vsix) as archive:
            document = ElementTree.fromstring(archive.read("extension.vsixmanifest"))
        assert document.find(".//v:Description", NAMESPACE).text == awkward
        assert document.find(".//v:DisplayName", NAMESPACE).text == "TikZ & co"


