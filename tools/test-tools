@test("tools/symbols-check reports what the provider highlights, and nothing else")
def _():
    # It used to re-implement the provider and drift from it: `table [x=xc]` sets the key
    # x, which the provider leaves alone even with an x/.style in the workspace.
    with tempfile.TemporaryDirectory() as tmp:
        figure = Path(tmp) / "figure.tex"
        figure.write_text(
            "\\def\\eps{1}\n\\tikzset{x/.style={red}}\n\\begin{tikzpicture}\n"
            "  \\addplot table [x=xc] {data.csv};\n  \\draw [x] (0,\\eps) -- (1,1);\n\\end{tikzpicture}\n"
        )
        result = node("tools/symbols-check.mjs", str(figure))
        assert result.returncode == 0, result.stderr
        out = plain(result.stdout)
        assert "style references that will be highlighted: 2" in out, out
        # --index stands in for the workspace scan, which leaves node_modules out.
        workspace = Path(tmp) / "workspace"
        (workspace / "node_modules" / "pkg").mkdir(parents=True)
        (workspace / "pre.tex").write_text("\\tikzset{flow/.style={->}}")
        (workspace / "node_modules" / "pkg" / "x.tex").write_text("\\tikzset{vendored/.style={red}}")
        indexed = plain(node("tools/symbols-check.mjs", str(figure), "--index", str(workspace)).stdout)
        assert "index: 1 styles" in indexed, indexed
        assert "x  line 2  (definition)" in out and "x  line 5" in out, out
        assert "x  line 4" not in out, out
        assert "macro occurrences that will be highlighted: 2" in out, out


@test("tools/theme-check lets an including theme override the theme it includes")
def _():
    # VS Code's own themes are chains -- dark_modern includes dark_plus includes dark_vs --
    # and a rule in the including theme wins over the same selector in its base.
    with tempfile.TemporaryDirectory() as tmp:
        base = Path(tmp) / "base.json"
        child = Path(tmp) / "child.json"
        base.write_text(
            json.dumps(
                {
                    "colors": {"editor.foreground": "#ffffff"},
                    "tokenColors": [{"scope": "constant.numeric", "settings": {"foreground": "#ffffff"}}],
                }
            )
        )
        child.write_text(
            json.dumps(
                {
                    # A string ending in an escaped backslash, then one holding "//": a
                    # stripper that misreads the first takes the second for a comment.
                    "name": "ends in a backslash \\",
                    "$schema": "vscode://schemas/color-theme",
                    "include": "./base.json",
                    "tokenColors": [{"scope": "constant.numeric", "settings": {"foreground": "#ff8800"}}],
                }
            )
        )
        result = node("tools/theme-check.mjs", str(child))
        assert result.returncode == 0, result.stderr
        out = plain(result.stdout)
        assert "dimension" not in out, f"the override was ignored:\n{out}"


@test("examples/fig.sh lets the preamble input files beside it")
def _():
    # latexmk -cd compiles from inside build/, where a relative \\input in the preamble is
    # not found -- unless TEXINPUTS puts the script's folder on the search path, after
    # build/ and ahead of TeX's own (the trailing separator).
    with tempfile.TemporaryDirectory() as tmp:
        project = Path(tmp) / "latex"
        (project / "figs").mkdir(parents=True)
        (project / "figs" / "flow.tex").write_text("\\begin{tikzpicture}\\end{tikzpicture}\n")
        texinputs, _, _ = run_example(project, project / "figs" / "flow.tex")
        # The shell reports its folder physically, so compare resolved paths: on macOS the
        # temporary folder is /var/..., which is a link to /private/var/....
        first, folder, rest = texinputs.split(os.pathsep, 2)
        assert first == ".", f"build/ should be searched first: {texinputs}"
        assert os.path.realpath(folder) == os.path.realpath(project), texinputs
        assert rest == "", f"TeX's own path should follow, by an empty last entry: {texinputs}"
        # A TEXINPUTS of the user's own is kept, and TeX's path still follows it.
        texinputs, _, _ = run_example(project, project / "figs" / "flow.tex", texinputs="/my/styles")
        assert texinputs.endswith(f"{os.pathsep}/my/styles{os.pathsep}"), texinputs


@test("examples/fig.sh wraps a .tikz picture body, and only that")
def _():
    # A .tikz file is picture body alone, its \\begin{tikzpicture} in the parent that inputs
    # it -- unless it was written with one, as tikzplotlib writes them. A .tex figure is input
    # as it stands, whatever environment it uses (forest, circuitikz, ...).
    with tempfile.TemporaryDirectory() as tmp:
        project = Path(tmp) / "latex"
        figs = project / "figs"
        figs.mkdir(parents=True)
        cases = {
            "body.tikz": ("\\draw (0,0) -- (1,1);\n", True),
            "whole.tikz": ("% from tikzplotlib\n\\begin{tikzpicture}\n\\draw (0,0);\n\\end{tikzpicture}\n", False),
            "tree.tex": ("\\begin{forest}[a[b]]\\end{forest}\n", False),
        }
        for name, (content, wrapped) in cases.items():
            (figs / name).write_text(content)
            _, tex, status = run_example(project, figs / name)
            inputs = f"\\input{{{figs / name}}}"
            assert inputs in tex, tex
            assert ("\\begin{tikzpicture}\n" + inputs + "\n\\end{tikzpicture}" in tex) == wrapped, f"{name}:\n{tex}"
            assert status == f"ok {Path(name).stem}", f"{name}: {status}"


@test("tools/audit.mjs exits 3, not 1, when a grammar will not load")
def _():
    # A grammar left mid-edit fails to parse, and that is when the audit is run; an uncaught
    # error exits 1, which a script gating on the audit would read as a runaway.
    with tempfile.TemporaryDirectory() as tmp:
        tree = copy_tree(Path(tmp) / "tree", git=False)
        grammar = tree / "syntaxes" / "tikz-toplevel.tmLanguage.json"
        grammar.write_text(grammar.read_text(encoding="utf-8")[:-10])
        result = run_script(tree / "tools" / "tm", tree, "tools/audit.mjs", "test/minimal.tex")
        assert result.returncode == 3, f"exit {result.returncode}: {result.stderr.strip()[-300:]}"
        assert "RUNAWAY" not in result.stdout, result.stdout


@test("none of the above touched the working tree")
def _():
    assert digest(ROOT) == BEFORE, "a tool test modified the repository"
    assert vsix_files() == VSIX_BEFORE, "a vsix was left in the tree, or one already there was rewritten"


if failures:
    for failure in failures:
        print(f"FAIL {failure}", file=sys.stderr)
    sys.exit(1)
print(f"ok: {run} tool tests")
