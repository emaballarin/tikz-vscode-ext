@test("tools/theme-check honours a rule's ancestor scopes, both ways")
def _():
    # A rule written "a b" applies to b only inside a. The picture's own scopes are the
    # ancestors every TikZ token has; maths is not among them.
    numeric = {"scope": "constant.numeric", "settings": {"foreground": "#ff8800"}}
    cases = {
        # More specific, and later -- but it needs maths around, which a dimension lacks.
        "inapplicable": ([numeric, {"scope": "meta.math.block constant.numeric", "settings": {"foreground": "#ffffff"}}], False),
        # The picture is around every TikZ token, so this applies, earlier or not.
        "applicable-earlier": ([{"scope": "meta.function.environment.latex.tikz constant.numeric", "settings": {"foreground": "#ffffff"}}, numeric], True),
        "applicable-later": ([numeric, {"scope": "meta.function.environment.latex.tikz constant.numeric", "settings": {"foreground": "#ffffff"}}], True),
    }
    for name, (rules, plain_text) in cases.items():
        with tempfile.TemporaryDirectory() as tmp:
            theme = Path(tmp) / f"{name}.json"
            theme.write_text(json.dumps({"colors": {"editor.foreground": "#ffffff"}, "tokenColors": rules}))
            result = tm("tools/theme-check.mjs", str(theme))
            assert result.returncode == 0, result.stderr
            out = plain(result.stdout)
            assert ("- dimension" in out) == plain_text, f"{name}: dimension should{'' if plain_text else ' not'} read as plain text:\n{out}"


@test("tools/tm falls back to a bundle's only executable, and says so when there is none")
def _():
    # A bundle whose product.json names no nameShort that exists: one executable is taken,
    # several are ambiguous and none is a bundle with nothing to run -- and either of
    # those must be said, not end the script without a word.
    def bundle(tmp, executables):
        app = Path(tmp) / "Some Editor.app"
        (app / "Contents" / "Resources" / "app").mkdir(parents=True)
        (app / "Contents" / "MacOS").mkdir()
        (app / "Contents" / "Resources" / "app" / "product.json").write_text('{"nameShort": "Absent"}')
        for name in executables:
            path = app / "Contents" / "MacOS" / name
            path.write_text(f'#!/bin/sh\necho "ran {name}"\n')
            path.chmod(0o755)
        return app

    def tm(app):
        return subprocess.run(
            [str(ROOT / "tools" / "tm")], env={**os.environ, "VSCODE": str(app)}, capture_output=True, text=True, check=False
        )

    with tempfile.TemporaryDirectory() as tmp:
        result = tm(bundle(tmp, ["Editor Helper"]))
        assert result.returncode == 0 and result.stdout.strip() == "ran Editor Helper", result
    for executables in ([], ["One", "Two"]):
        with tempfile.TemporaryDirectory() as tmp:
            result = tm(bundle(tmp, executables))
            assert result.returncode != 0, f"{executables}: ran something"
            assert "holds no VS Code executable" in result.stderr, f"{executables}: exited without a word: {result}"


@test("tools/theme-check reports what the editor's matcher paints, case by case")
def _():
    orange = {"foreground": "#ff8800"}
    white = {"foreground": "#ffffff"}
    # A theme colouring bare `meta` gives the whole picture that colour, node text included:
    # a token left at it reads as plain text, though it is not the editor foreground.
    out = theme_check([{"scope": "meta", "settings": {"foreground": "#9ab8d4"}}, {"scope": "constant.numeric", "settings": orange}], "#cce5ff")
    assert "- option key (#9ab8d4" in out and "- dimension" not in out, out
    # "a > b" needs a as the immediate parent; a dimension's is the picture, not the document.
    out = theme_check([{"scope": "constant.numeric", "settings": orange}, {"scope": "text.tex.latex > constant.numeric", "settings": white}])
    assert "- dimension" not in out, out
    # A semantic token is matched alone, so a rule needing the picture around it misses it.
    out = theme_check([{"scope": "variable", "settings": orange}, {"scope": "meta.function.environment.latex.tikz variable", "settings": white}])
    assert "- macro (semantic)" not in out and "- coordinate" in out, out
    # Between two ancestor rules, the more specific ancestor wins whatever the order.
    out = theme_check([{"scope": "meta.function constant.numeric", "settings": orange}, {"scope": "text constant.numeric", "settings": white}])
    assert "- dimension" not in out, out
    # A more specific rule setting only a font style still takes the token, colour and all.
    out = theme_check([{"scope": "meta.function.environment.latex.tikz constant.numeric", "settings": orange}, {"scope": "constant.numeric.dimension", "settings": {"fontStyle": "italic"}}])
    assert "- dimension" in out, out


@test("tools/theme-check builds the theme as the editor does before asking")
def _():
    black = {"foreground": "#000000"}
    keyword = {"scope": "keyword.operator", "settings": black}
    # No editor.foreground: VS Code uses the default for the kind of theme, #292929 for a
    # light high-contrast one, so black operators stand out; against #000000 they would not.
    out = theme_check([keyword], None, type="hcLight")
    assert "- assignment" not in out, out
    out = theme_check([{"scope": "keyword.operator", "settings": {"foreground": "#bbbbbb"}}], None, type="dark")
    assert "- assignment (#bbbbbb" in out, out
    # A rule with no scope is dropped by the editor, not applied to everything.
    out = theme_check([{"settings": {"foreground": "#123456"}}, {"scope": "constant.numeric", "settings": {"foreground": "#ffffff"}}])
    assert "- dimension" in out, out
    # Short colours are spelt out before they are compared.
    out = theme_check([{"scope": "constant.numeric", "settings": {"foreground": "#cccccc"}}], "#ccc")
    assert "- dimension" in out, out
    # A child combinator that does hold applies: a dimension's parent is the picture.
    out = theme_check(
        [{"scope": "constant.numeric", "settings": {"foreground": "#ff8800"}},
         {"scope": "meta.function.environment.latex.tikz > constant.numeric", "settings": {"foreground": "#ffffff"}}]
    )
    assert "- dimension" in out, out
    # A semantic token with no rule of its own is said to keep the grammar's colour.
    assert "- macro (semantic) (no rule of its own" in theme_check([]), "semantic wording"


