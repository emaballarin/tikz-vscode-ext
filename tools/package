#!/bin/sh
# Package the extension as a .vsix, with nothing but tar, zip, and the python3 that
# tools/check already needs.
#
# Dropping a folder into ~/.vscode/extensions is no longer enough: VS Code takes
# extensions.json there as the source of truth and marks anything else obsolete at
# startup. A .vsix is only a zip -- the source under extension/, next to the two
# metadata files the installer reads -- so there is still no npm and no vsce here.
set -e

cd "$(dirname "$0")/.."
# In place, without sed -i: BSD sed wants `-i ''` and GNU sed reads that '' as the script.
edit() { sed "$1" "$2" > "$2.tmp" && mv "$2.tmp" "$2"; }

# python3 rather than a sed capture, because the fields cross two encodings. They are JSON,
# so their escapes have to be decoded: a raw capture ships `\\` where package.json means
# one backslash. And they land in XML, so their metacharacters have to be escaped: an `&`
# or a `<` in the display name makes the manifest ill-formed, and the installer rejects it
# without saying why. A capture also took the first line that looked like the key, which
# held only while each key happened to come first at the top level.
fields=$(python3 - <<'PY'
import json
from shlex import quote
from xml.sax.saxutils import escape

manifest = json.load(open("package.json", encoding="utf-8"))
# Only the free-text fields need escaping; the rest are identifiers, a path and a semver
# range, which the marketplace grammar already confines to characters XML does not mind.
for key, value in (
    ("name", manifest["name"]),
    ("publisher", manifest["publisher"]),
    ("version", manifest["version"]),
    ("icon", manifest["icon"]),
    ("engine", manifest["engines"]["vscode"]),
    ("display", escape(manifest["displayName"])),
    ("summary", escape(manifest["description"])),
):
    print(f"{key}={quote(value)}")
PY
)
eval "$fields"

out="$PWD/$name-$version.vsix"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT

mkdir -p "$stage/extension"
# What ships is what git would commit: tracked files, and new ones it does not ignore. The
# .gitignore files say what is not source -- nested ones included, which is how a tool's
# cache usually keeps itself out (ruff writes "*" into .ruff_cache/.gitignore) -- and an
# exclude list here would always be one cache behind. A tracked file deleted from the tree
# is left out rather than failing the tar -- one that is not there, that is, and not one
# that merely cannot be read, which must stop the packaging. git cannot tell the two apart
# (it lists files in an unreadable folder as deleted), so the error itself decides. Outside a git checkout there is no such list,
# and the excludes stand in for it, the VS Code that CI downloads among them.
#
# Each step writes a file rather than feeding a pipe: under sh -e only the last command of
# a pipeline counts, so a tar that failed on one unreadable file let the extraction
# succeed, and the vsix went out short.
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  # git skips a folder it cannot open with a warning and carries on, exit 0 -- for a folder
  # it does not track yet, that is the only sign the folder exists. Any word from it fails,
  # since a warning is the only way it reports that, and git's own text is shown.
  git ls-files -z --cached --others --exclude-standard > "$stage/listed" 2> "$stage/warned"
  if [ -s "$stage/warned" ]; then
    cat "$stage/warned" >&2
    echo "package: stopping, since git did not list the tree cleanly (its words are above)" >&2
    exit 1
  fi
  python3 -c '
import os, sys
listed, files = sys.argv[1:]
paths = []
with open(listed, "rb") as source:
    for path in source.read().split(b"\0"):
        if not path:
            continue
        try:
            os.lstat(path)
        except (FileNotFoundError, NotADirectoryError):
            continue
        except OSError as error:
            sys.exit(f"package: cannot read {os.fsdecode(path)}: {error.strerror}")
        paths.append(path)
with open(files, "wb") as target:
    target.write(b"".join(p + b"\0" for p in paths))
' "$stage/listed" "$stage/files"
  tar -cf "$stage/tree.tar" --null -T "$stage/files"
else
  tar -cf "$stage/tree.tar" --exclude=.git --exclude=node_modules --exclude=.DS_Store --exclude='*.vsix' \
    --exclude=__pycache__ --exclude=.vscode-test --exclude=.ruff_cache .
fi
tar -xf "$stage/tree.tar" -C "$stage/extension"
# The stage is the root of the zip, so nothing but the extension may be left in it.
rm -f "$stage/tree.tar" "$stage/listed" "$stage/warned" "$stage/files"

# The extension editor sanitises a README down to http(s) image sources -- a relative
# path draws a broken tile, and so does a data: URI with the image inside it. So the
# staged README points at the raw file on GitHub, pinned to the commit that last touched
# that file: a branch URL keeps serving a cached copy after the image is replaced, which
# is how the page spent an afternoon showing the wrong screenshot. The checked-in README
# keeps its relative paths, which is what GitHub renders.
slug=$(git config --get remote.origin.url | sed -e 's|.*[:/]\([^/]*/[^/]*\)$|\1|' -e 's|\.git$||')
for img in $(sed -n 's/.*](\(images\/[^)]*\)).*/\1/p' README.md | sort -u); do
  # Outside a git checkout -- a downloaded source tree -- there is nothing to pin to, and
  # the image is dropped below rather than shipped as a broken tile.
  sha=$(git log -1 --format=%H -- "$img" 2>/dev/null || true)
  if [ -n "$slug" ] && [ -n "$sha" ]; then
    [ -n "$(git status --porcelain -- "$img")" ] &&
      echo "warning: $img has uncommitted changes; the packaged README will point at the committed one" >&2
    # Fetching a pinned URL before its commit is pushed makes GitHub cache the 404, so
    # the page stays broken for minutes after the push lands. Push first, then package.
    [ -z "$(git branch -r --contains "$sha" 2>/dev/null)" ] &&
      echo "warning: $sha is not on any remote yet; push before packaging or the image URL will 404" >&2
    edit "s|](${img})|](https://raw.githubusercontent.com/${slug}/${sha}/${img})|g" "$stage/extension/README.md"
  else
    edit "\|](${img})|d" "$stage/extension/README.md"
  fi
done

cat > "$stage/extension.vsixmanifest" <<XML
<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="$name" Version="$version" Publisher="$publisher" />
    <DisplayName>$display</DisplayName>
    <Description xml:space="preserve">$summary</Description>
    <Tags>latex,tikz</Tags>
    <Categories>Programming Languages</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value="$engine" />
      <Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
      <Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
      <Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
    </Properties>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Code" />
  </Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/$icon" Addressable="true" />
  </Assets>
</PackageManifest>
XML

cat > "$stage/[Content_Types].xml" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension=".json" ContentType="application/json" />
  <Default Extension=".jsonc" ContentType="application/json" />
  <Default Extension=".js" ContentType="application/javascript" />
  <Default Extension=".mjs" ContentType="application/javascript" />
  <Default Extension=".md" ContentType="text/markdown" />
  <Default Extension=".png" ContentType="image/png" />
  <Default Extension=".sh" ContentType="text/plain" />
  <Default Extension=".svg" ContentType="image/svg+xml" />
  <Default Extension=".tex" ContentType="text/plain" />
  <Default Extension=".vsixmanifest" ContentType="text/xml" />
</Types>
XML

rm -f "$out"
(cd "$stage" && zip -qr "$out" .)
echo "$out"
