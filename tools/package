#!/bin/sh
# Package the extension as a .vsix, with nothing but tar and zip.
#
# Dropping a folder into ~/.vscode/extensions is no longer enough: VS Code takes
# extensions.json there as the source of truth and marks anything else obsolete at
# startup. A .vsix is only a zip -- the source under extension/, next to the two
# metadata files the installer reads -- so there is still no npm and no vsce here.
set -e

cd "$(dirname "$0")/.."
field() { sed -n "s/.*\"$1\": \"\([^\"]*\)\".*/\1/p" package.json | head -1; }
# In place, without sed -i: BSD sed wants `-i ''` and GNU sed reads that '' as the script.
edit() { sed "$1" "$2" > "$2.tmp" && mv "$2.tmp" "$2"; }

name=$(field name)
publisher=$(field publisher)
version=$(field version)
display=$(field displayName)
summary=$(field description)
icon=$(field icon)
engine=$(sed -n 's/.*"vscode": "\([^"]*\)".*/\1/p' package.json | head -1)

out="$PWD/$name-$version.vsix"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT

mkdir -p "$stage/extension"
tar -cf - --exclude=.git --exclude='*.vsix' --exclude=__pycache__ . | (cd "$stage/extension" && tar -xf -)

# The extension editor sanitises a README down to http(s) image sources -- a relative
# path draws a broken tile, and so does a data: URI with the image inside it. So the
# staged README points at the raw file on GitHub, pinned to the commit that last touched
# that file: a branch URL keeps serving a cached copy after the image is replaced, which
# is how the page spent an afternoon showing the wrong screenshot. The checked-in README
# keeps its relative paths, which is what GitHub renders.
slug=$(git config --get remote.origin.url | sed -e 's|.*[:/]\([^/]*/[^/]*\)$|\1|' -e 's|\.git$||')
for img in $(sed -n 's/.*](\(images\/[^)]*\)).*/\1/p' README.md | sort -u); do
  sha=$(git log -1 --format=%H -- "$img")
  if [ -n "$slug" ] && [ -n "$sha" ]; then
    [ -n "$(git status --porcelain -- "$img")" ] &&
      echo "warning: $img has uncommitted changes; the packaged README will point at the committed one" >&2
    # Fetching a pinned URL before its commit is pushed makes GitHub cache the 404, so
    # the page stays broken for minutes after the push lands. Push first, then package.
    [ -z "$(git branch -r --contains "$sha" 2>/dev/null)" ] &&
      echo "warning: $sha is not on any remote yet; push before packaging or the image URL will 404" >&2
    edit "s|](${img})|](https://raw.githubusercontent.com/${slug}/${sha}/${img})|g" "$stage/extension/README.md"
  else
    edit "\|](${img})|d" "$stage/extension/README.md"
  fi
done

cat > "$stage/extension.vsixmanifest" <<XML
<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Language="en-US" Id="$name" Version="$version" Publisher="$publisher" />
    <DisplayName>$display</DisplayName>
    <Description xml:space="preserve">$summary</Description>
    <Tags>latex,tikz</Tags>
    <Categories>Programming Languages</Categories>
    <GalleryFlags>Public</GalleryFlags>
    <Properties>
      <Property Id="Microsoft.VisualStudio.Code.Engine" Value="$engine" />
      <Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
      <Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="" />
      <Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
    </Properties>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Code" />
  </Installation>
  <Dependencies/>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true" />
    <Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/$icon" Addressable="true" />
  </Assets>
</PackageManifest>
XML

cat > "$stage/[Content_Types].xml" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">
  <Default Extension=".json" ContentType="application/json" />
  <Default Extension=".jsonc" ContentType="application/json" />
  <Default Extension=".js" ContentType="application/javascript" />
  <Default Extension=".mjs" ContentType="application/javascript" />
  <Default Extension=".md" ContentType="text/markdown" />
  <Default Extension=".png" ContentType="image/png" />
  <Default Extension=".sh" ContentType="text/plain" />
  <Default Extension=".svg" ContentType="image/svg+xml" />
  <Default Extension=".tex" ContentType="text/plain" />
  <Default Extension=".vsixmanifest" ContentType="text/xml" />
</Types>
XML

rm -f "$out"
(cd "$stage" && zip -qr "$out" .)
echo "$out"
