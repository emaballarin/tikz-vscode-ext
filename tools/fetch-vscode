#!/bin/sh
# Download the newest VS Code of one quality into .vscode-test/, and print where it went.
#
#   VSCODE=$(./tools/fetch-vscode stable) ./tools/test
#   VSCODE=$(./tools/fetch-vscode insider) ./tools/tm tools/test-grammar.mjs
#
# The grammar tests run VS Code's own TextMate engine and LaTeX grammar, so which VS Code
# matters, and CI asks for the newest of each quality rather than a pinned build: Stable is
# what people run today, Insiders what they will run next. The update service names the
# build and its SHA-256, which is checked before anything is unpacked, and a build already
# in place is not fetched again. Works on Linux (x64, arm64) and macOS.
set -e

quality=${1:?usage: fetch-vscode stable|insider}
case "$quality" in
  stable | insider) ;;
  *) echo "fetch-vscode: quality is stable or insider, not $quality" >&2; exit 2 ;;
esac

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) platform=linux-x64 ;;
  Linux-aarch64 | Linux-arm64) platform=linux-arm64 ;;
  Darwin-*) platform=darwin-universal ;;
  *) echo "fetch-vscode: no VS Code build for $(uname -s) $(uname -m)" >&2; exit 1 ;;
esac

cd "$(dirname "$0")/.."
dest="$PWD/.vscode-test/$quality"

latest=$(curl -fsSL --retry 3 --retry-delay 5 "https://update.code.visualstudio.com/api/update/$platform/$quality/latest" | python3 -c '
import json, sys
build = json.load(sys.stdin)
print(build["url"], build["version"], build["sha256hash"], build["productVersion"])
')
read -r url commit sha256 version <<EOF
$latest
EOF

# The installation inside $dest: a bundle on macOS, the folder itself on Linux. Prints
# nothing, and still succeeds, when there is none -- set -e would otherwise end the script
# at the assignment that asks.
installed() {
  for app in "$dest"/*.app; do
    if [ -d "$app" ]; then
      echo "$app"
      return 0
    fi
  done
  if [ -f "$dest/resources/app/product.json" ]; then
    echo "$dest"
  fi
  return 0
}

app=$(installed)
if [ -n "$app" ] && grep -q "\"commit\": *\"$commit\"" "$app"/Contents/Resources/app/product.json "$app"/resources/app/product.json 2>/dev/null; then
  echo "fetch-vscode: $quality $version ($commit) already in place" >&2
  echo "$app"
  exit 0
fi

echo "fetch-vscode: downloading $quality $version ($commit) for $platform" >&2
download=$(mktemp)
trap 'rm -f "$download"' EXIT
curl -fsSL --retry 3 --retry-delay 5 "$url" -o "$download"
python3 - "$download" "$sha256" <<'PY'
import hashlib, sys
path, expected = sys.argv[1:]
digest = hashlib.sha256()
with open(path, "rb") as f:
    for block in iter(lambda: f.read(1 << 20), b""):
        digest.update(block)
if digest.hexdigest() != expected:
    sys.exit(f"fetch-vscode: SHA-256 mismatch, {digest.hexdigest()} != {expected}")
PY

rm -rf "$dest"
mkdir -p "$dest"
case "$platform" in
  darwin-*) unzip -q "$download" -d "$dest" ;;
  *) tar -xzf "$download" -C "$dest" --strip-components=1 ;;
esac

app=$(installed)
if [ -z "$app" ]; then
  echo "fetch-vscode: unpacked $url but found no VS Code in it" >&2
  exit 1
fi
echo "$app"
